{
  "$defs": {
    "InteractionMode": {
      "description": "The interaction model active for the current editor session.\n\nPhase 0 has one native model, `select`. A caret is an empty selection.",
      "oneOf": [
        {
          "const": "select",
          "description": "Selection-first editing. Insertion and navigation both act on a selection.",
          "type": "string"
        }
      ]
    },
    "Selection": {
      "description": "One selection. A caret is an empty selection where `anchor == head`.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/TextPosition",
          "description": "Fixed end of the selection."
        },
        "head": {
          "$ref": "#/$defs/TextPosition",
          "description": "Moving end of the selection."
        }
      },
      "required": [
        "anchor",
        "head"
      ],
      "type": "object"
    },
    "TextPosition": {
      "description": "A position in the document.\n\nAll indices are zero-based. `byte_offset` is a UTF-8 byte offset;\n`char_column` counts Unicode scalars; `grapheme_column` counts extended\ngrapheme clusters; `display_column` counts terminal cells and accounts for\nwide characters. The editor owns the conversions and guarantees the fields\ndescribe the same cursor position. Plugins receive positions from\n`editor.get_view`; construction stays editor-owned until a future\n`set_selection` contract validates it.",
      "properties": {
        "byte_offset": {
          "description": "UTF-8 byte offset from the start of the document.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "char_column": {
          "description": "Zero-based Unicode scalar column.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "display_column": {
          "description": "Zero-based terminal display-cell column.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "grapheme_column": {
          "description": "Zero-based grapheme-cluster column.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "description": "Zero-based line number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "byte_offset",
        "line",
        "char_column",
        "grapheme_column",
        "display_column"
      ],
      "type": "object"
    },
    "Viewport": {
      "description": "The visible region of the document.",
      "properties": {
        "first_column": {
          "description": "First visible display column for horizontal scrolling.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "first_line": {
          "description": "First visible line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "description": "Visible height in terminal rows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line_count": {
          "description": "Number of visible lines.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Visible width in terminal cells.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "first_line",
        "first_column",
        "line_count",
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `editor.get_view`.\n\nPhase 0 has at least one selection and one native mode (`select`).",
  "properties": {
    "interaction_mode": {
      "$ref": "#/$defs/InteractionMode",
      "description": "Session interaction mode."
    },
    "revision": {
      "description": "Monotonic document revision at snapshot time.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "selections": {
      "description": "Current selections; Phase 0 normally contains one caret/selection.",
      "items": {
        "$ref": "#/$defs/Selection"
      },
      "type": "array"
    },
    "viewport": {
      "$ref": "#/$defs/Viewport",
      "description": "Visible document region."
    }
  },
  "required": [
    "revision",
    "interaction_mode",
    "viewport",
    "selections"
  ],
  "title": "EditorView",
  "type": "object"
}