{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request to read a bounded file chunk.",
  "properties": {
    "max_bytes": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "offset": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "type": "string"
    }
  },
  "required": [
    "path",
    "offset",
    "max_bytes"
  ],
  "title": "ReadFileRequest",
  "type": "object"
}