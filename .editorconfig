root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,toml,json,jsonc}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{patch,diff}]
trim_trailing_whitespace = false
